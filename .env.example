# AICortex — settings (copy to .env). Since 2.7.1 everything else is built in:
# data folders under /data, rate limits, HSTS, the audit log, size limits, and the
# protections (roles always enforced, vault always encrypted, no open mode).
# Leftovers from older releases are ignored; the start log names them.

# ── Container ─────────────────────────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Europe/Berlin

# ── Required: public address and sign-in ──────────────────────────────────
# The address people and apps use (the OAuth resource is BASE_URL/mcp).
BASE_URL=https://agent.example.com
# Your OIDC provider (Pocket ID, Authentik, Keycloak …). Register a confidential
# client with the redirect URIs <BASE_URL>/auth/callback and <BASE_URL>/ui/callback.
OIDC_CONFIG_URL=https://id.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Signs tokens and WebUI sessions:   openssl rand -hex 32
JWT_SIGNING_KEY=
# Encrypts the vault and stored sign-ins (a Fernet key) — keep a copy in your
# password manager:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Private networks integrations may reach (LAN/VPN). Empty = blocked.
# INTERNAL_ALLOW_CIDRS=192.168.1.0/24
# Who may tell AICortex the real client IP (your reverse proxy). Never "*".
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# Admins (operators): your IdP "sub", comma-separated. Without it the first person
# to sign in after a start becomes the operator (within 30 minutes).
# OPERATORS=
# Extra OAuth callback patterns for apps that aren't built in (Claude, ChatGPT and
# loopback desktop/CLI apps are). https patterns, * = wildcard. Never "*" alone.
# MCP_REDIRECT_URIS=https://app.example.com/oauth/*
# Only while rotating the encryption key: the previous key (then "Re-encrypt" in
# the WebUI vault and remove this line).
# STORAGE_ENCRYPTION_KEY_OLD=

# ── Rarely needed ─────────────────────────────────────────────────────────
# Scopes requested at your IdP (add "groups" to map IdP groups to roles).
# OIDC_SCOPE=openid profile email
# Token claim that carries the group/role (mapped in data/auth/policy.json).
# AUTH_ROLE_CLAIM=groups
# Static token for an external runner outside AICortex: openssl rand -hex 32
# RUNNER_TOKEN=
# Strict host check: only these Host names (plus BASE_URL's host and localhost).
# MCP_ALLOWED_HOSTS=
# Mail recipients, the default tool profile and auto-memory are set in the WebUI
# (Overview → Settings) since 2.7.1.
